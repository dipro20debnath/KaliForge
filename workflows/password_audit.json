{
  "name": "Password Audit",
  "id": "password_audit",
  "description": "Authorised credential-strength testing against a single in-scope service. Lab/engagement use only.",
  "inputs": ["target", "user", "wordlist"],
  "steps": [
    {"tool": "nmap", "template": "nmap -p22,21,3389,445 --open {target}", "optional": true},
    {"tool": "nmap", "template": "nmap --script ssh-auth-methods -p22 {target}", "optional": true},
    {"tool": "hydra", "template": "hydra -l {user} -P {wordlist} -t 4 -f ssh://{target}"}
  ]
}
